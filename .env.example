# Local development keys. Doppler is the source of truth: the project
# macp-runtime, config dev, holds these. Prefer
#
#   doppler setup --project macp-runtime --config dev   # once per checkout
#   doppler run -- make test-integration-e2e
#
# This file is the fallback for contributors without Doppler access: copy it
# to .env (gitignored) and fill in your own keys. `make test-integration-e2e`
# and docker-compose.yml read .env only when the variable is not already set.

# Tier 3 real-LLM tests (docs/testing.md)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
