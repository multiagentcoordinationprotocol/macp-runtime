{
  "_comment": "RFC-MACP-0008 Section 5 rule 4: a withdrawn proposal MUST NOT later be committed. Both participants accept p1, which makes the Session eligible; then its author withdraws it, and the eligibility is gone.",
  "description": "Proposal Mode: withdrawing a fully accepted proposal removes Commitment eligibility.",
  "mode": "macp.mode.proposal.v1",
  "initiator": "agent://buyer",
  "participants": [
    "agent://buyer",
    "agent://seller"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy_version": "",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://seller",
      "message_type": "Proposal",
      "payload_type": "macp.modes.proposal.v1.ProposalPayload",
      "payload": {
        "proposal_id": "p1",
        "title": "offer",
        "summary": "terms",
        "details": [],
        "tags": []
      },
      "expect": "accept"
    },
    {
      "sender": "agent://buyer",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "sender": "agent://seller",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 2.1: the seller authored p1, so it may withdraw it. Nothing in Section 5 forbids withdrawing a proposal that has been accepted.",
      "sender": "agent://seller",
      "message_type": "Withdraw",
      "payload_type": "macp.modes.proposal.v1.WithdrawPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": "withdrawn"
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 5 rule 4: every participant's acceptance names p1, but p1 is withdrawn, so it MUST NOT be committed.",
      "sender": "agent://buyer",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "proposal.accepted",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.default",
        "configuration_version": "cfg-1",
        "outcome_positive": true
      },
      "expect": "reject",
      "expected_error_code": "INVALID_ENVELOPE"
    }
  ],
  "expected_final_state": "Open",
  "expect_resolution_present": false,
  "expected_mode_state": {
    "proposals": {
      "p1": {
        "proposal_id": "p1",
        "proposer": "agent://seller",
        "disposition": "Withdrawn"
      }
    }
  }
}
