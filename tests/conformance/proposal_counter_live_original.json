{
  "_comment": "RFC-MACP-0008 Section 5 rules 2a and 5: a CounterProposal does not retire the proposal it supersedes, and a participant's latest Accept replaces its earlier one. A runtime that retires p1 on the counter rejects index 2; a runtime that keeps every Accept accepts the Commitment at index 5.",
  "description": "Proposal Mode: the original stays live beside its counter, the latest Accept per participant is the one that counts, and only the initiator may commit.",
  "mode": "macp.mode.proposal.v1",
  "initiator": "agent://buyer",
  "participants": [
    "agent://buyer",
    "agent://seller"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy_version": "",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://seller",
      "message_type": "Proposal",
      "payload_type": "macp.modes.proposal.v1.ProposalPayload",
      "payload": {
        "proposal_id": "p1",
        "title": "offer",
        "summary": "terms",
        "details": [],
        "tags": []
      },
      "expect": "accept"
    },
    {
      "sender": "agent://buyer",
      "message_type": "CounterProposal",
      "payload_type": "macp.modes.proposal.v1.CounterProposalPayload",
      "payload": {
        "proposal_id": "p2",
        "supersedes_proposal_id": "p1",
        "title": "counter",
        "summary": "revised terms"
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 5 rule 2a: p2 supersedes p1 in intent only; p1 stays live and MAY still be accepted.",
      "sender": "agent://buyer",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 5 rule 5: the buyer moves its acceptance from p1 to p2.",
      "sender": "agent://buyer",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p2",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "sender": "agent://seller",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 5 rules 5 and 6: the buyer's latest Accept names p2 and the seller's names p1, so no single live proposal has been accepted by every required participant.",
      "sender": "agent://buyer",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "proposal.accepted",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.default",
        "configuration_version": "cfg-1",
        "outcome_positive": true
      },
      "expect": "reject",
      "expected_error_code": "INVALID_ENVELOPE"
    },
    {
      "_comment": "RFC-MACP-0008 Section 5 rule 5: the buyer moves its acceptance back to p1; both participants now accept p1.",
      "sender": "agent://buyer",
      "message_type": "Accept",
      "payload_type": "macp.modes.proposal.v1.AcceptPayload",
      "payload": {
        "proposal_id": "p1",
        "reason": ""
      },
      "expect": "accept"
    },
    {
      "_comment": "RFC-MACP-0008 Section 2.1 and Section 3: the Session is now eligible, but the seller is not the Commitment authority (the initiator is, and no policy overrides it).",
      "sender": "agent://seller",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "proposal.accepted",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.default",
        "configuration_version": "cfg-1",
        "outcome_positive": true
      },
      "expect": "reject",
      "expected_error_code": "FORBIDDEN"
    },
    {
      "sender": "agent://buyer",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "proposal.accepted",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.default",
        "configuration_version": "cfg-1",
        "outcome_positive": true
      },
      "expect": "accept"
    }
  ],
  "expected_final_state": "Resolved",
  "expect_resolution_present": true,
  "expected_resolution": {
    "action": "proposal.accepted",
    "mode_version": "1.0.0",
    "configuration_version": "cfg-1",
    "outcome_positive": true
  },
  "expected_mode_state": {
    "phase": "Committed",
    "accepts": {
      "agent://buyer": "p1",
      "agent://seller": "p1"
    },
    "proposals": {
      "p1": {
        "proposal_id": "p1",
        "proposer": "agent://seller",
        "disposition": "Live"
      },
      "p2": {
        "proposal_id": "p2",
        "proposer": "agent://buyer",
        "disposition": "Live"
      }
    }
  }
}
