{
  "_comment": "Pins RFC-MACP-0012 Section 4.3 rejection.terminal_on_any_reject with RFC-MACP-0008 Section 5 rule 6: under the policy a Reject sent with terminal false is terminal, so the session becomes eligible for a negative Commitment. Without the policy the same Commitment would be rejected as not yet eligible.",
  "description": "Proposal Mode: terminal_on_any_reject makes a non-terminal Reject terminal; the negative Commitment is accepted.",
  "mode": "macp.mode.proposal.v1",
  "initiator": "agent://buyer",
  "participants": [
    "agent://buyer",
    "agent://seller"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.proposal.terminal-on-any-reject",
    "mode": "macp.mode.proposal.v1",
    "schema_version": 3,
    "description": "Any rejection is terminal.",
    "rules": {
      "rejection": {
        "terminal_on_any_reject": true
      }
    }
  },
  "policy_version": "policy.proposal.terminal-on-any-reject",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://seller",
      "message_type": "Proposal",
      "payload_type": "macp.modes.proposal.v1.ProposalPayload",
      "payload": {
        "proposal_id": "p1",
        "title": "offer",
        "summary": "terms",
        "details": [],
        "tags": []
      },
      "expect": "accept"
    },
    {
      "_comment": "terminal is false on the wire; the policy makes it terminal.",
      "sender": "agent://buyer",
      "message_type": "Reject",
      "payload_type": "macp.modes.proposal.v1.RejectPayload",
      "payload": {
        "proposal_id": "p1",
        "terminal": false,
        "reason": "too expensive"
      },
      "expect": "accept"
    },
    {
      "_comment": "Eligible through the terminal rejection.",
      "sender": "agent://buyer",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "outcome_positive": false,
        "action": "proposal.rejected",
        "authority_scope": "test",
        "reason": "commitment c1",
        "mode_version": "1.0.0",
        "policy_version": "policy.proposal.terminal-on-any-reject",
        "configuration_version": "cfg-1"
      },
      "expect": "accept"
    }
  ],
  "expected_final_state": "Resolved",
  "expect_resolution_present": true,
  "expected_resolution": {
    "action": "proposal.rejected",
    "mode_version": "1.0.0",
    "configuration_version": "cfg-1",
    "outcome_positive": false
  }
}
