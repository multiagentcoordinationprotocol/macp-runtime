{
  "_comment": "Pins 'plurality' end to end: the schema_version 3 empty-tally denial, the tie-fails rule (previously unfixtured anywhere in the corpus), and the passing case. 'plurality' takes no threshold, so the empty tally and the tie are the same failure -- zero approvals are not strictly more than zero rejections (RFC-MACP-0012 4.1).",
  "description": "Decision Mode: 'plurality' denies the empty tally and a tie, and passes on a strict plurality.",
  "mode": "macp.mode.decision.v1",
  "initiator": "agent://orchestrator",
  "participants": [
    "agent://orchestrator",
    "agent://a",
    "agent://b"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.decision.plurality-v3",
    "mode": "macp.mode.decision.v1",
    "schema_version": 3,
    "description": "Plurality vote, initiator-only commitment, schema_version 3 fail-closed empty-tally semantics.",
    "rules": {
      "voting": {
        "algorithm": "plurality"
      },
      "commitment": {
        "authority": "initiator_only"
      }
    }
  },
  "policy_version": "policy.decision.plurality-v3",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://orchestrator",
      "message_type": "Proposal",
