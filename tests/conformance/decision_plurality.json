        "option": "deploy",
        "rationale": "ready",
        "supporting_data": []
      },
      "expect": "accept"
    },
    {
      "_comment": "schema_version 3, empty tally. 'plurality' needs no special case: zero approvals against zero rejections is a tie, and a tie fails (RFC-MACP-0012 4.1).",
      "sender": "agent://orchestrator",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c0",
        "outcome_positive": true,
        "action": "decision.selected",
        "authority_scope": "test",
        "reason": "positive commitment attempted on an empty decisive tally",
        "mode_version": "1.0.0",
        "policy_version": "policy.decision.plurality-v3",
        "configuration_version": "cfg-1"
      },
      "expect": "reject",
      "expected_error_code": "POLICY_DENIED"
    },
    {
      "sender": "agent://a",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "ship it"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://b",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "REJECT",
        "reason": "regression risk"
      },
      "expect": "accept"
    },
    {
      "_comment": "'plurality' requires strictly MORE approvals than rejections. 1 approve against 1 reject is a tie and fails. This tie-fails rule was previously unfixtured.",
      "sender": "agent://orchestrator",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "outcome_positive": true,
        "action": "decision.selected",
        "authority_scope": "test",
        "reason": "positive commitment attempted at a 1-1 tie",
        "mode_version": "1.0.0",
        "policy_version": "policy.decision.plurality-v3",
        "configuration_version": "cfg-1"
      },
      "expect": "reject",
      "expected_error_code": "POLICY_DENIED"
    },
    {
      "sender": "agent://orchestrator",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "confirmed"
