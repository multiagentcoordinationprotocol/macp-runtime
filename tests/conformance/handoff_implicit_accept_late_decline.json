{
  "_comment": "Pins RFC-MACP-0010 Section 5.1(4), second sentence, with Section 5.1(2) and RFC-MACP-0001 Section 7.6 item 5: once the deadline has elapsed, the synthetic HandoffAccept is due and is appended before the runtime evaluates the next session-scoped envelope. The offer is accepted at 1000 with a 1000 ms timeout (deadline 2000). The target's decline is evaluated at 2500, so the synthetic accept enters history first and the decline is then invalid (rule 4). The positive Commitment at 2600 is accepted. Every Envelope timestamp_unix_ms is 0.",
  "description": "Handoff Mode: a decline evaluated after the implicit-accept deadline is rejected, because the synthetic accept is appended first.",
  "mode": "macp.mode.handoff.v1",
  "initiator": "agent://owner",
  "participants": [
    "agent://owner",
    "agent://target"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.handoff.implicit-accept-1000",
    "mode": "macp.mode.handoff.v1",
    "schema_version": 3,
    "description": "Implicit accept after 1000 ms of unanswered offer; initiator-only commitment.",
    "rules": {
      "acceptance": {
        "implicit_accept_timeout_ms": 1000
      },
      "commitment": {
        "authority": "initiator_only"
      }
    }
  },
  "policy_version": "policy.handoff.implicit-accept-1000",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://owner",
      "message_type": "HandoffOffer",
      "payload_type": "macp.modes.handoff.v1.HandoffOfferPayload",
      "payload": {
        "handoff_id": "h1",
        "target_participant": "agent://target",
        "scope": "support",
        "reason": "escalate"
      },
      "accepted_at_ms": 1000,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "accept"
    },
    {
      "_comment": "Acceptance time 2500 is past the deadline of 2000. The synthetic HandoffAccept is appended before this envelope is evaluated, so the decline competes with a settled offer.",
      "sender": "agent://target",
      "message_type": "HandoffDecline",
      "payload_type": "macp.modes.handoff.v1.HandoffDeclinePayload",
      "payload": {
        "handoff_id": "h1",
        "declined_by": "agent://target",
        "reason": "at capacity"
      },
      "accepted_at_ms": 2500,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "reject",
      "expected_error_code": "INVALID_ENVELOPE"
    },
    {
      "sender": "agent://owner",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "handoff.accepted",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.handoff.implicit-accept-1000",
        "configuration_version": "cfg-1",
        "outcome_positive": true
      },
      "accepted_at_ms": 2600,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "accept"
    }
  ],
  "expected_history": [
    {
      "message_type": "HandoffOffer",
      "sender": "agent://owner",
      "payload": {
        "handoff_id": "h1"
      }
    },
    {
      "message_type": "HandoffAccept",
      "sender": "agent://target",
      "payload": {
        "handoff_id": "h1",
        "accepted_by": "agent://target",
        "implicit": true
      },
      "synthetic": true
    },
    {
      "message_type": "Commitment",
      "sender": "agent://owner",
      "payload": {
        "commitment_id": "c1"
      }
    }
  ],
  "expected_final_state": "Resolved",
  "expected_resolution": {
    "action": "handoff.accepted",
    "mode_version": "1.0.0",
    "configuration_version": "cfg-1",
    "outcome_positive": true
  },
  "expected_mode_state": {
    "offers": {
      "h1": {
        "disposition": "Accepted"
      }
    }
  }
}
