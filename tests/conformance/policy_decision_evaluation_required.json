{
  "_comment": "Pins RFC-MACP-0012 Section 4.1 evaluation.required_before_voting together with RFC-MACP-0007 Section 4: a REVIEW evaluation is informational only and does not satisfy the prerequisite. The vote alone passes (2/2 approve), so only the missing qualifying evaluation denies the commitment. RFC-MACP-0007 Section 5 rule 6 closes deliberation at the first accepted Vote, so every Evaluation precedes every ballot and each fixture can pin only one evaluation state.",
  "description": "Decision Mode: required_before_voting is not satisfied by a REVIEW evaluation.",
  "mode": "macp.mode.decision.v1",
  "initiator": "agent://orchestrator",
  "participants": [
    "agent://orchestrator",
    "agent://a",
    "agent://b"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.decision.evaluation-required",
    "mode": "macp.mode.decision.v1",
    "schema_version": 3,
    "description": "Majority with an evaluation required before voting.",
    "rules": {
      "voting": {
        "algorithm": "majority",
        "threshold": 0.5
      },
      "evaluation": {
        "required_before_voting": true
      },
      "commitment": {
        "authority": "initiator_only"
      }
    }
  },
  "policy_version": "policy.decision.evaluation-required",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://orchestrator",
      "message_type": "Proposal",
      "payload_type": "macp.modes.decision.v1.ProposalPayload",
      "payload": {
        "proposal_id": "p1",
        "option": "deploy",
        "rationale": "ready",
        "supporting_data": []
      },
      "expect": "accept"
    },
    {
      "_comment": "REVIEW is analysis without a stance (RFC-MACP-0007 Section 4).",
      "sender": "agent://a",
      "message_type": "Evaluation",
      "payload_type": "macp.modes.decision.v1.EvaluationPayload",
      "payload": {
        "proposal_id": "p1",
        "recommendation": "REVIEW",
        "confidence": 0.9,
        "reason": "assessed"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://a",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "approve"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://b",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "approve"
      },
      "expect": "accept"
    },
    {
      "_comment": "The vote passes 2/2, but the only evaluation is REVIEW, so no qualifying evaluation exists.",
      "sender": "agent://orchestrator",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "outcome_positive": true,
        "action": "decision.selected",
        "authority_scope": "test",
        "reason": "commitment c1",
        "mode_version": "1.0.0",
        "policy_version": "policy.decision.evaluation-required",
        "configuration_version": "cfg-1"
      },
      "expect": "reject",
      "expected_error_code": "POLICY_DENIED"
    }
  ],
  "expected_final_state": "Open"
}
