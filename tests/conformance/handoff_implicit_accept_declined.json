{
  "_comment": "Pins RFC-MACP-0010 Section 5.1(4), first sentence: an explicit HandoffDecline accepted into history before the implicit-accept deadline settles the offer, and the synthetic accept is then never emitted. The offer is accepted at 1000 with a 1000 ms timeout (deadline 2000); the decline is accepted at 1500. At 2500 the deadline has passed, but h1 is no longer outstanding, so expected_history MUST contain no synthetic HandoffAccept and the negative Commitment is accepted. Every Envelope timestamp_unix_ms is 0.",
  "description": "Handoff Mode: an explicit decline before the implicit-accept deadline wins; no synthetic accept is emitted.",
  "mode": "macp.mode.handoff.v1",
  "initiator": "agent://owner",
  "participants": [
    "agent://owner",
    "agent://target"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.handoff.implicit-accept-1000",
    "mode": "macp.mode.handoff.v1",
    "schema_version": 3,
    "description": "Implicit accept after 1000 ms of unanswered offer; initiator-only commitment.",
    "rules": {
      "acceptance": {
        "implicit_accept_timeout_ms": 1000
      },
      "commitment": {
        "authority": "initiator_only"
      }
    }
  },
  "policy_version": "policy.handoff.implicit-accept-1000",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://owner",
      "message_type": "HandoffOffer",
      "payload_type": "macp.modes.handoff.v1.HandoffOfferPayload",
      "payload": {
        "handoff_id": "h1",
        "target_participant": "agent://target",
        "scope": "support",
        "reason": "escalate"
      },
      "accepted_at_ms": 1000,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "accept"
    },
    {
      "sender": "agent://target",
      "message_type": "HandoffDecline",
      "payload_type": "macp.modes.handoff.v1.HandoffDeclinePayload",
      "payload": {
        "handoff_id": "h1",
        "declined_by": "agent://target",
        "reason": "at capacity"
      },
      "accepted_at_ms": 1500,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "accept"
    },
    {
      "sender": "agent://owner",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "action": "handoff.declined",
        "authority_scope": "test",
        "reason": "done",
        "mode_version": "1.0.0",
        "policy_version": "policy.handoff.implicit-accept-1000",
        "configuration_version": "cfg-1",
        "outcome_positive": false
      },
      "accepted_at_ms": 2500,
      "envelope": {
        "timestamp_unix_ms": 0
      },
      "expect": "accept"
    }
  ],
  "expected_history": [
    {
      "message_type": "HandoffOffer",
      "sender": "agent://owner",
      "payload": {
        "handoff_id": "h1"
      }
    },
    {
      "message_type": "HandoffDecline",
      "sender": "agent://target",
      "payload": {
        "handoff_id": "h1"
      }
    },
    {
      "message_type": "Commitment",
      "sender": "agent://owner",
      "payload": {
        "commitment_id": "c1"
      }
    }
  ],
  "expected_final_state": "Resolved",
  "expected_resolution": {
    "action": "handoff.declined",
    "mode_version": "1.0.0",
    "configuration_version": "cfg-1",
    "outcome_positive": false
  },
  "expected_mode_state": {
    "offers": {
      "h1": {
        "disposition": "Declined"
      }
    }
  }
}
