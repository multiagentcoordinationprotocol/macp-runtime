{
  "_comment": "Companion to policy_decision_minimum_confidence.json, at or above the floor: one evaluation at 0.5 (below 0.8, not valid) and one at 0.9 (valid). One valid evaluation satisfies required_before_voting, so the passing vote commits. A runtime that required EVERY evaluation to meet the floor would deny it (see the spec question). RFC-MACP-0007 Section 5 rule 6 closes deliberation at the first accepted Vote, so every Evaluation precedes every ballot and each fixture can pin only one evaluation state.",
  "description": "Decision Mode: with minimum_confidence 0.8, one evaluation at 0.9 qualifies even beside one at 0.5.",
  "mode": "macp.mode.decision.v1",
  "initiator": "agent://orchestrator",
  "participants": [
    "agent://orchestrator",
    "agent://a",
    "agent://b"
  ],
  "mode_version": "1.0.0",
  "configuration_version": "cfg-1",
  "policy": {
    "policy_id": "policy.decision.minimum-confidence-met",
    "mode": "macp.mode.decision.v1",
    "schema_version": 3,
    "description": "Majority with a required evaluation at confidence 0.8 or higher.",
    "rules": {
      "voting": {
        "algorithm": "majority",
        "threshold": 0.5
      },
      "evaluation": {
        "required_before_voting": true,
        "minimum_confidence": 0.8
      },
      "commitment": {
        "authority": "initiator_only"
      }
    }
  },
  "policy_version": "policy.decision.minimum-confidence-met",
  "ttl_ms": 60000,
  "messages": [
    {
      "sender": "agent://orchestrator",
      "message_type": "Proposal",
      "payload_type": "macp.modes.decision.v1.ProposalPayload",
      "payload": {
        "proposal_id": "p1",
        "option": "deploy",
        "rationale": "ready",
        "supporting_data": []
      },
      "expect": "accept"
    },
    {
      "sender": "agent://a",
      "message_type": "Evaluation",
      "payload_type": "macp.modes.decision.v1.EvaluationPayload",
      "payload": {
        "proposal_id": "p1",
        "recommendation": "APPROVE",
        "confidence": 0.5,
        "reason": "assessed"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://b",
      "message_type": "Evaluation",
      "payload_type": "macp.modes.decision.v1.EvaluationPayload",
      "payload": {
        "proposal_id": "p1",
        "recommendation": "APPROVE",
        "confidence": 0.9,
        "reason": "assessed"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://a",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "approve"
      },
      "expect": "accept"
    },
    {
      "sender": "agent://b",
      "message_type": "Vote",
      "payload_type": "macp.modes.decision.v1.VotePayload",
      "payload": {
        "proposal_id": "p1",
        "vote": "APPROVE",
        "reason": "approve"
      },
      "expect": "accept"
    },
    {
      "_comment": "b's evaluation at 0.9 >= 0.8 qualifies.",
      "sender": "agent://orchestrator",
      "message_type": "Commitment",
      "payload_type": "macp.v1.CommitmentPayload",
      "payload": {
        "commitment_id": "c1",
        "outcome_positive": true,
        "action": "decision.selected",
        "authority_scope": "test",
        "reason": "commitment c1",
        "mode_version": "1.0.0",
        "policy_version": "policy.decision.minimum-confidence-met",
        "configuration_version": "cfg-1"
      },
      "expect": "accept"
    }
  ],
  "expected_final_state": "Resolved",
  "expect_resolution_present": true,
  "expected_resolution": {
    "action": "decision.selected",
    "mode_version": "1.0.0",
    "configuration_version": "cfg-1",
    "outcome_positive": true
  }
}
