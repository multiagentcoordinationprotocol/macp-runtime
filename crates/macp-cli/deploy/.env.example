# Optional. `docker compose up` works without a .env: these are the defaults
# docker-compose.yml already uses. Copy to .env to change any of them.
#
#   cp .env.example .env

# --- Local credentials ---------------------------------------------------------
# Every default below is a publicly known placeholder. Generate real values
# (`openssl rand -hex 32`) before this stack is reachable from anywhere else.
# API key for the control plane's HTTP API (Authorization: Bearer <key>). The
# console and the playground are given the same key. No commas.
MACP_CP_API_KEY=macp-dev-key

# API key for the playground's HTTP API (x-api-key). The console is given the
# same key. Playground images after 0.2.1 refuse to boot in production without it.
MACP_PLAYGROUND_API_KEY=macp-dev-playground-key

# Shared key auth-service requires on POST /tokens (its TOKEN_ISSUER_KEYS); the
# playground sends it as MACP_AUTH_SERVICE_API_KEY. auth-service images after
# 1.0.0 refuse to boot without it.
MACP_TOKEN_ISSUER_KEY=macp-dev-token-issuer-key

# Static bearer the control plane presents to the runtime. The runtime maps it
# to sender macp-control-plane with observer rights.
MACP_CP_RUNTIME_TOKEN=macp-dev-cp-observer

POSTGRES_PASSWORD=macp
# Postgres reads this only when it first creates its volume. After changing it,
# reset with `docker compose down -v` (this deletes all run history).

# --- Decision receipts ---------------------------------------------------------
# Leave empty for unsigned receipts. To sign, set the key to a private Ed25519
# JWK on one line; its kid, or MACP_RECEIPT_SIGNING_KID, names it. Signing also
# needs MACP_RUNTIME_ID, the issuer (runtime:<id>) of every receipt; the runtime
# refuses to start without it. Never commit a real key.
MACP_RECEIPT_SIGNING_KEY=
MACP_RECEIPT_SIGNING_KID=
MACP_RUNTIME_ID=

# --- Host ports (all bound to 127.0.0.1) ---------------------------------------
MACP_CONSOLE_PORT=3000
MACP_CP_PORT=3001
MACP_PLAYGROUND_PORT=3100
MACP_RUNTIME_PORT=50051

# --- Image overrides -----------------------------------------------------------
# Leave unset to use the pinned tags in docker-compose.yml. For example, to try
# a runtime you built from this checkout (`docker build -t macp-runtime:dev ..`):
# MACP_RUNTIME_IMAGE=macp-runtime:dev
# MACP_CONTROL_PLANE_IMAGE=
# MACP_PLAYGROUND_IMAGE=
# MACP_AUTH_SERVICE_IMAGE=
# MACP_UI_CONSOLE_IMAGE=
